{
  "name": "@polyforge/paperclip-plugin",
  "version": "0.1.0",
  "private": true,
  "description": "Thin Paperclip control-plane bridge for the PolyForge engineering graph",
  "type": "module",
  "license": "Apache-2.0",
  "paperclipPlugin": {
    "manifest": "dist/manifest.js",
    "worker": "dist/worker.js",
    "ui": "dist/ui"
  },
  "files": [
    "dist",
    "migrations"
  ],
  "scripts": {
    "build": "node build.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.ui.json --noEmit",
    "test": "node --test --experimental-strip-types \"tests/**/*.test.ts\""
  },
  "dependencies": {
    "@polyforge/protocol": "0.1.0"
  },
  "devDependencies": {
    "@paperclipai/plugin-sdk": "2026.916.1",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.6.0"
  }
}
